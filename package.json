{
  "name": "content-forge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/fonts/ensure-fonts.mjs && node scripts/ci/use-e2e-outputs.mjs && node scripts/platform/aws-outputs-to-config.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fonts/ensure-fonts.mjs && node scripts/ci/use-e2e-outputs.mjs && node scripts/platform/aws-outputs-to-config.mjs",
    "build": "next build",
    "build:e2e": "NEXT_PUBLIC_DEMO_MODE=0 npm run build",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "typecheck": "node scripts/ci/use-e2e-outputs.mjs && node scripts/platform/aws-outputs-to-config.mjs && next typegen && tsc --noEmit && tsc --noEmit -p amplify/tsconfig.json && tsc --noEmit -p infra/edge-cert/tsconfig.json && tsc --noEmit -p infra/auth/tsconfig.json",
    "pretest": "node scripts/ci/use-e2e-outputs.mjs && node scripts/platform/aws-outputs-to-config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e --project=e2e-firefox --project=e2e-webkit",
    "test:smoke": "playwright test --project=smoke",
    "test:infra": "vitest run -c vitest.infra.config.ts",
    "demo:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo/generate-demo-assets.mjs",
    "beta:deploy": "bash scripts/beta/deploy.sh"
  },
  "dependencies": {
    "aws-amplify": "^6.22.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/cloudfront-signer": "^3.1161.0",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/lato": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk-lib": "^2.275.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}

{
  "name": "content-forge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/fonts/ensure-fonts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fonts/ensure-fonts.mjs",
    "build": "next build",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo/generate-demo-assets.mjs",
    "beta:deploy": "bash scripts/beta/deploy.sh"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}

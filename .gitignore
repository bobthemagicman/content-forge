# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Playwright storageState from a real Workspace login (contains session tokens)
tests/smoke/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.log
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# keys & certificates
# The CloudFront private key lives only in SSM; never commit key material.
*.pem
*.key
*.p12
*.pfx
*private-key*
# ...except the per-environment CloudFront public keys, which backend.ts reads at synth
!amplify/custom/assets-cdn/keys/*.public-key.pem
# ...but not the throwaway keys tests/infra/auth-client.test.ts writes, if a run is killed
amplify/custom/assets-cdn/keys/sandbox-vitest-*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# amplify gen 2 (sandbox state and generated, per-environment config)
.amplify/
amplify_outputs*
# ...except the fake-environment fixture CI and the beta preview build against (T041)
!tests/e2e/fixtures/amplify_outputs.e2e.json
amplifyconfiguration*

# aws cdk (infra/edge-cert and any other CDK app)
cdk.out/

# ingest CLI local artifacts
ingest-report*.json
.ingest-state.json
.ingest-tmp/

# claude code (per-user local settings; shared skills in .claude/skills are committed)
.claude/settings.local.json

# licensed fonts: not redistributable, so never committed (see quickstart §2, step 5)
src/app/fonts/*.woff
src/app/fonts/*.woff2

# playwright mcp screenshots and snapshots
.playwright-mcp/
